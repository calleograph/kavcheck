# Разрешённые в репозитории домены и адреса: зарезервированные для документации (RFC 2606/6761), вымышленные примеры и публичная инфраструктура.
# Всё остальное проверка scripts/check_private_data.py считает возможной частной настройкой конкретной организации.
example.com
example.org
example.net
example.local
example
test
invalid
localhost
github.com
githubusercontent.com
ghcr.io
docker.io
docker.com
microsoft.com
kaspersky.com
kaspersky.ru
support.kaspersky.com
threats.kaspersky.com
pypi.org
npmjs.org
debian.org
ubuntu.com
gitverse.ru
w3.org
# IP-адреса: loopback, документационные (RFC 5737), маски и примеры версий
ip:127\.0\.0\.\d+
ip:0\.0\.0\.0
ip:192\.0\.2\.\d+
ip:198\.51\.100\.\d+
ip:203\.0\.113\.\d+
# RFC 2544: диапазон для испытаний (крупная синтетическая база)
ip:198\.1[89]\.\d+\.\d+
ip:255\.255\.255\.\d+
ip:172\.30\.10\.33
# идентификаторы линеек продуктов Kaspersky вида 11.0.0.0 (не адреса)
ip:\d{1,3}\.0\.0\.0
sil.org
# публичные источники сведений об уязвимостях (база уязвимостей)
bdu.fstec.ru
fstec.ru
osv.dev
storage.googleapis.com
crates.io
raw.githubusercontent.com
gu-st.ru
nuc-cdp.digital.gov.ru
digital.gov.ru
voskhod.ru
# база endoflife.date (срез в тестах): публичные сайты производителей, идентификаторы и номера версий, похожие на адреса
dev.mysql.com
java.sun.com
container-registry.oracle.com
microsoft.netcore.app
ip:26\.0\.2\.1
ip:18\.0\.2\.1

# Pentest: частные диапазоны RFC 1918 в области разрешений по умолчанию, служебные адреса в тестах проверки области
ip:172\.16\.0\.0
ip:192\.168\.0\.0
ip:169\.254\.\d+\.\d+
ip:224\.0\.0\.\d+
oval.mitre.org
mitre.org
