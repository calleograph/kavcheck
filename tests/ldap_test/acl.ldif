# Права тестового каталога: сервисная учётная запись читает всё (кроме паролей), пользователи входят своим паролем
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=example,dc=local" write by anonymous auth by * none
olcAccess: {1}to * by dn.exact="uid=svc-kavcheck,ou=People,dc=example,dc=local" read by dn="cn=admin,dc=example,dc=local" write by self read by * none
