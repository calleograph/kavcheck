# =============================================================================
# .env.example — все переменные конфигурации экземпляра KAV Checker.
# Копия для сервера: `cp .env.example .env && chmod 600 .env`, затем заполнить. Настоящий .env в Git не хранится.
# Значения ниже — примеры формата. Заглушки CHANGE_ME обязательны к замене (scripts/install.sh генерирует секреты сам).
# =============================================================================

# Имя compose-проекта на этом хосте (префикс контейнеров, сетей, томов): a-z, 0-9, '-', '_'.
COMPOSE_PROJECT_NAME=kavcheck

# Публичный адрес приложения (схема + хост, без пути). Используется для проверки Origin (CSRF) и ссылок. Приложение размещается за внешним reverse proxy с TLS.
APP_PUBLIC_URL=https://kavcheck.example.org
# Дополнительные адреса, с которых открывают приложение (через запятую), если их несколько.
ALLOWED_ORIGINS=

# Корень постоянных данных (вне каталога репозитория): postgres/, reports/, backups/, updater/.
DATA_ROOT=/srv/kavcheck-data

# Веб-порт контейнера web. По умолчанию только loopback: наружу выставляет внешний nginx/reverse proxy.
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=18080

# Флаг Secure у cookie сессии: auto (по умолчанию) — включён, если APP_PUBLIC_URL начинается с https:// или reverse proxy передаёт
# X-Forwarded-Proto: https. После перехода стенда с HTTP на HTTPS достаточно поменять APP_PUBLIC_URL. true | false — принудительно.
COOKIE_SECURE=auto
# Сколько прокси перед приложением (для X-Forwarded-For).
TRUSTED_PROXY_HOPS=1

# --- Внутренняя база PostgreSQL (контейнер; наружу не публикуется)
POSTGRES_DB=kavcheck
POSTGRES_USER=kavcheck
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Ключ шифрования паролей источников KSC и LDAP: base64 от 32 случайных байт (`openssl rand -base64 32`).
# Потеря ключа = потеря сохранённых паролей (их придётся ввести заново). Храните резервную копию .env отдельно.
APP_MASTER_KEY=CHANGE_ME_base64_32_bytes

# --- Образы. Основной способ обновления — готовые образы релиза из GitHub Container Registry (ghcr.io/<владелец>/kavcheck-backend|web:vX.Y.Z): быстро и без
# Docker Hub, npm и pip. Репозиторий образов определяется по IMAGE_REGISTRY, иначе по GITHUB_REPO или адресу remote origin. IMAGE_REPO/IMAGE_TAG — какие образы запущены сейчас
# (обновляются скриптами); локально собранные образы называются <проект>-backend:<commit>.
IMAGE_REPO=kavcheck
IMAGE_TAG=dev
IMAGE_REGISTRY=
# Локальная сборка при обновлении — только по явному решению: UPDATE_MODE=build (всегда собирать) или UPDATE_ALLOW_BUILD=1 (собрать, если готовые образы недоступны;
# в журнале будет предупреждение). По умолчанию (UPDATE_MODE=auto, UPDATE_ALLOW_BUILD=0) при недоступных образах обновление останавливается, работает прежняя версия.
UPDATE_MODE=auto
UPDATE_ALLOW_BUILD=0
# Тайм-ауты обновления, секунды (значения по умолчанию в скобках): UPD_TIMEOUT_PULL (1800) и UPD_STALL_PULL (300 — нет прогресса) для загрузки образов,
# UPD_TIMEOUT_BUILD (2400) и UPD_STALL_BUILD (900) для сборки, UPD_TIMEOUT_MIGRATE (600), UPD_TIMEOUT_BACKUP (900), UPD_TIMEOUT_UP (300),
# UPD_TIMEOUT_TOTAL (5400) и UPD_STALL_TOTAL (1500 — нет вывода) для всего обновления целиком.
# Зеркала для локальной сборки образов (если registry.npmjs.org или pypi.org недоступны или медленны). Пусто — официальные реестры.
# Пример зеркала npm: https://npm-mirror.gitverse.ru . Контрольные суммы пакетов проверяются по package-lock.json в любом случае.
NPM_REGISTRY=
PIP_INDEX_URL=
# Репозиторий GitHub для проверки релизов (владелец/имя).
GITHUB_REPO=CHANGE_ME_owner/kavcheck

# --- Сессии и ограничения
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
# Предел строк одного отчёта, одновременных запросов к источнику и одновременных отчётов у воркера; срок кэша справочников (с).
KSC_MAX_ROWS=100000
KSC_CONCURRENCY=3
REPORT_CONCURRENCY=2
CACHE_TTL_SECONDS=600

# --- Журналы: DEBUG|INFO|WARNING|ERROR ; json|console
LOG_LEVEL=INFO
LOG_FORMAT=json
# Документация внутреннего API (/api/v1/docs) — только для разработки.
DOCS_ENABLED=false
